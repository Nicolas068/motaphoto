@font-face{font-family:"Poppins";src:url(//mota-photo.local/wp-content/themes/mota-photo/assets/fonts/Poppins-Bold.woff2) format("woff2");font-weight:700;font-style:normal;font-display:swap}@font-face{font-family:"Space Mono";src:url(//mota-photo.local/wp-content/themes/mota-photo/assets/fonts/SpaceMono-Regular.woff2) format("woff2");font-weight:400;font-style:normal;font-display:swap}body{max-width:1400px;margin:0 auto;padding:0 40px}header{display:flex;justify-content:space-between;align-items:center;padding:10px 120px}.logo-img{max-height:80px;height:14px;width:216 px;margin-top:0}header ul{list-style:none;display:flex;gap:20px;margin-top:0}header ul li a{text-decoration:none;color:#000;font-size:16px;position:relative;right:100px}.menu-toggle{display:none}@media (max-width:768px){#site-header{flex-direction:column;align-items:stretch;position:relative;z-index:1000}.header-top{display:flex;justify-content:center;align-items:center;position:relative;width:100%;margin-bottom:10px}.logo-img{height:10px;max-height:14px;margin-right:80px}.menu-toggle{display:block;position:absolute;right:-94px;font-size:2rem;background:0 0;border:none;cursor:pointer}.my-menu-principal{max-height:0;overflow:hidden;flex-direction:column;background:#fff;position:absolute;top:100%;left:0;right:0;padding:0 20px;border-top:1px solid #ddd;box-sizing:border-box;transition:max-height .4s ease}.my-menu-principal.active{max-height:500px;padding:20px}.my-menu-principal li{margin:15px 0;list-style:none;text-align:center}.my-menu-principal li a{display:inline-block;padding:5px 10px;margin-left:55%;font-size:20px;color:#000;text-decoration:none;transition:background .3s ease,color .3s ease}.my-menu-principal li a:hover{color:#2f2f2f}}.my-footer-menu{list-style:none;display:flex;gap:20px;justify-content:center;padding:0;margin:50px}.my-footer-menu li a{color:#000;text-decoration:none;font-size:16px;padding:5px 10px;transition:background .3s ease,color .3s ease}.my-footer-menu li a:hover{color:#2f2f2f}@media (max-width:768px){.my-footer-menu{flex-direction:column;align-items:center;gap:10px}}.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);z-index:9999}.modal-content{position:relative;width:597px;max-height:92vh;margin:auto;top:50%;transform:translateY(-50%);background:#fff;border:3px solid #000;box-sizing:border-box;overflow:hidden;padding-bottom:20px}.modal-close{position:absolute;top:15px;right:20px;font-size:28px;font-weight:700;cursor:pointer;color:#000;z-index:10}.modal-content:before{content:"TACTCONTACTCON\A NTACTCONTACTCO";position:absolute;font-family:"Space Mono",monospace;font-style:italic;font-weight:400;font-size:5rem;color:#000;white-space:pre-line;line-height:1;z-index:1}.modal-content .wpcf7-form{text-align:center;position:relative;z-index:2;margin-top:180px;font-family:"Space Mono",monospace;font-weight:400;color:#111}.modal-content .wpcf7-form label{display:block;width:273px;margin:10px auto 5px;font-size:.85rem;font-weight:400;text-align:left;letter-spacing:.5px}.modal-content .wpcf7-form input[type=text],.modal-content .wpcf7-form input[type=email],.modal-content .wpcf7-form input[type=tel],.modal-content .wpcf7-form input[type=url],.modal-content .wpcf7-form input[type=number]{width:273px;height:63px;margin:10px auto;display:block;padding:0 12px;font-size:.95rem;font-weight:400;border-radius:4px;border:1px solid #333;box-sizing:border-box}.modal-content .wpcf7-form textarea{width:273px;height:210px;margin:10px auto;display:block;padding:12px;font-size:.95rem;font-weight:400;border-radius:4px;border:1px solid #333;box-sizing:border-box;resize:none}.modal-content .wpcf7-form input[type=submit]{width:273px;height:63px;margin:10px auto 20px;display:block;font-size:1rem;font-weight:400;letter-spacing:1px;border:none;border-radius:4px;background:#d8d8d8;color:#000;cursor:pointer;transition:background .3s}.modal-content .wpcf7-form input[type=submit]:hover{background:#e00000}@media (max-width:768px){.modal-content{width:90%;padding:15px 10px 20px}.modal-content:before{font-size:3rem;line-height:1.1;left:2%;top:5%}.modal-content .wpcf7-form{margin-top:100px}.modal-content .wpcf7-form input[type=text],.modal-content .wpcf7-form input[type=email],.modal-content .wpcf7-form input[type=tel],.modal-content .wpcf7-form input[type=url],.modal-content .wpcf7-form input[type=number],.modal-content .wpcf7-form textarea,.modal-content .wpcf7-form input[type=submit]{width:100%;max-width:100%}.modal-content .wpcf7-form input[type=submit]{width:85%;max-width:240px;height:50px;font-size:.95rem;margin:15px auto}}@media (max-width:480px){.modal-content{width:95%;border-width:2px}.modal-content:before{font-size:3rem;line-height:1.1;top:1%}.modal-close{font-size:20px;top:8px;right:10px}.modal-content .wpcf7-form input[type=submit]{width:90%;height:45px;font-size:.9rem;letter-spacing:.5px;margin:12px auto}}.photo-layout{display:flex;align-items:flex-end;justify-content:space-between}.photo-infos{width:50%;padding:40px;box-sizing:border-box;font-family:"Space Mono",monospace;display:flex;flex-direction:column;justify-content:flex-end;height:100%;margin-left:40px}.photo-title{font-size:4rem;font-style:italic;margin-bottom:20px;font-weight:400;text-transform:uppercase;line-height:58px}.photo-infos p{margin:6px 0;font-size:1rem;text-transform:uppercase;font-family:"Space Mono",monospace}.photo-display{display:flex;justify-content:center;align-items:flex-end}.photo-display img{display:block}.photo-img.portrait{width:500px;height:700px;object-fit:cover;object-position:center bottom;margin-right:15%}.photo-img.landscape{width:688px;height:500px;object-fit:cover;object-position:center bottom}.photo-display.landscape{align-items:flex-end}.photo-display.portrait{align-items:center}.photo-footer-wrapper{width:100%;position:relative}.photo-footer{position:relative;max-width:700px;display:flex;justify-content:space-between;align-items:center}.photo-footer:before{content:"";position:absolute;top:0;right:0;height:1px;background:#000;width:calc(100% - 72px)}.photo-footer-wrapper:after{content:"";display:block;width:80%;height:1px;background:#000;margin-left:69px}.photo-contact{display:flex;align-items:center;justify-content:space-between;width:100%;padding-top:10px;margin-left:70px}.photo-contact p{margin:0;font-size:.9rem;text-transform:uppercase;margin-top:50px;position:relative;top:-18px}.btn-contact{background:#d8d8d8;border:none;text-decoration:none;color:#000;text-transform:none;font-size:1vw;border-radius:.3vw;transition:background .3s ease;width:16vw;height:5vh;display:flex;justify-content:center;align-items:center;position:relative;left:4vw}.btn-contact:hover{background:#000;color:#fff}.photo-navigation{display:flex;gap:20px;align-items:center;position:relative}.photo-navigation a{font-size:2rem;color:#000;text-decoration:none;position:relative;left:465px;top:50px}.photo-navigation a:after{content:"";position:fixed;top:50%;right:20px;transform:translateY(-50%);width:160px;height:120px;background-size:cover;background-position:center;border:1px solid #ccc;display:none;z-index:2000}.photo-navigation a:hover:after{display:block;background-image:attr(data-thumb url)}@media (max-width:768px){.photo-layout{flex-direction:column;height:auto}.photo-infos,.photo-display{width:100%;height:auto}.photo-footer{flex-direction:column;height:auto;padding:20px;gap:15px}}