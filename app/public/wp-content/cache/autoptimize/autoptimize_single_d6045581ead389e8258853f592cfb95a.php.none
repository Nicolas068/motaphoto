document.addEventListener("DOMContentLoaded",function(){const contactLink=document.querySelector('a[href*="contact"]');const modal=document.getElementById("contact-modal");const closeBtn=document.querySelector(".modal-close");if(contactLink){contactLink.addEventListener("click",function(e){e.preventDefault();modal.style.display="block";});}
window.addEventListener("click",function(e){if(e.target===modal){modal.style.display="none";}});});document.addEventListener("DOMContentLoaded",function(){const toggle=document.querySelector(".menu-toggle");const menu=document.querySelector(".my-menu-principal");if(toggle&&menu){toggle.addEventListener("click",function(){menu.classList.toggle("active");toggle.textContent=menu.classList.contains("active")?"✖":"☰";});}});document.querySelectorAll('.photo-navigation a').forEach(link=>{link.addEventListener('mouseenter',()=>{const thumbUrl=link.getAttribute('data-thumb');const preview=document.getElementById('thumb-preview');if(thumbUrl){preview.style.backgroundImage=`url(${thumbUrl})`;preview.style.display='block';}});link.addEventListener('mouseleave',()=>{const preview=document.getElementById('thumb-preview');preview.style.display='none';});});